# Readable reads its configuration from the environment. Every variable is optional: unset, the default is used.
# Copy the ones you need into your shell, CI or Vercel project settings.

# Where the emails' images are served from (and the site's own address). Set it for a fork deployed elsewhere.
SITE_URL=https://readable-email.vercel.app

# The source repository: each rule's "see" link and the site's links point here.
REPO_URL=https://github.com/Failureguy94/readable

# The date printed on the conformance reports, YYYY-MM-DD. Unset, it's the day of the build.
# BUILD_DATE=2026-11-27

# The Chrome or Chromium `npm run build` prints the reports with. Found automatically if it's installed.
# CHROME_PATH=/usr/bin/google-chrome

# The port `npm run serve` listens on.
PORT=3000
